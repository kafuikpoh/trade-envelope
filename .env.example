# Copy to .env and fill in. .env is gitignored; never commit a real secret.

# The .NET API. The browser never calls this directly — everything goes through the /api/* proxy.
API_BASE_URL=http://localhost:5000

# Enforce the (app) session guard and reject unauthenticated /api/* calls.
AUTH_ENABLED=false

# OIDC sign-in: authorization code + PKCE, straight to Keycloak, over a *public* client. There is no
# client secret here on purpose — a secret in a server-rendered app would still have to be kept away from
# the browser, and the public client is what makes that unnecessary. The confidential client and its
# secret belong to the .NET API (see appsettings.Development.json), which alone talks to Keycloak's
# Admin REST.
#
# Keycloak: Clients -> trade-envelope-public-client ->
#   Valid redirect URIs   http://localhost:5173/callback      (exact; a wildcard would let any path on
#                                                              this origin receive the authorisation code)
#   Web origins           http://localhost:5173
#   Valid post-logout redirect URIs  http://localhost:5173/login
#   PKCE (Code Challenge Method)     S256
#   Client scopes: profile and email must be assigned, and the audience scope that mints the API's
#   `aud` claim (trade-envelope-api) must be a *default* scope of this client.
KEYCLOAK_ISSUER_URL=http://localhost:18080/realms/trade-envelope
KEYCLOAK_CLIENT_ID=trade-envelope-public-client

# Externally reachable origin of this app. The redirect URI, the post-logout URI and the cookie `secure`
# flag derive from it, so a deployment on https needs only this value changed — and the same URI registered
# at the provider.
AUTH_REDIRECT_BASE_URL=http://localhost:5173

PUBLIC_APP_NAME=TradeEnvelope
