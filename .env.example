# Copy to .env and fill in. .env is gitignored; never commit a real secret.

# The .NET API. The browser never calls this directly — everything goes through the /api/* proxy.
API_BASE_URL=http://localhost:5000
API_SECRET=

# Enforce the (app) session guard and reject unauthenticated /api/* calls.
AUTH_ENABLED=false

# OIDC. Issuer = Keycloak realm; the client must be confidential with PKCE set to S256 and
# http://localhost:5173/callback listed as a valid redirect URI.
KEYCLOAK_ISSUER_URL=http://localhost:18080/realms/trade-envelope
KEYCLOAK_CLIENT_ID=trade-envelope-confidential-client
# Keycloak: Clients -> trade-envelope-confidential-client -> Credentials -> Copy client secret.
# Sign-in refuses to start until this is set; the app otherwise builds and runs without it.
KEYCLOAK_CLIENT_SECRET=

# Externally reachable origin of this app. The redirect URI and the cookie `secure` flag derive
# from it, so a deployment on https needs only this value changed.
AUTH_REDIRECT_BASE_URL=http://localhost:5173

PUBLIC_APP_NAME=TradeEnvelope
